# ============================================================
# EXTROVERT — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets.
# Production values belong in Vercel → Environment Variables.
# ============================================================

# SUPABASE — PUBLIC CLIENT CONFIG
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# APP IDENTITY
NEXT_PUBLIC_APP_NAME=Extrovert
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE — SERVER-ONLY SECRETS
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# EXTROVERT OWNER
DATEBU_OWNER_ID=

# FEEDBACK
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# DIRECT UPI PAYMENTS
# Public payment address used by the in-app UPI checkout.
EXTROVERT_UPI_ID=gauravbhardwaj7489@okaxis

# OPTIONAL — RESEND
# RESEND_API_KEY=

# EXTROVERT PUBLIC ORIGIN
# Use exactly one origin in production. Do not comma-separate URLs.
EXTROVERT_URL=https://extrovert-nu.vercel.app

# SUPABASE CLI
# SUPABASE_ACCESS_TOKEN=
# PROJECT_REF=zbdxhngtcuhmuxvptupu

# AUTH CALLBACKS
# Local: http://localhost:3000/auth/callback
# Production: https://extrovert-nu.vercel.app/auth/callback

# ============================================================
